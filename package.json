{
  "name": "eldenring-web-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config viewer/vite.config.ts",
    "build": "vite build --config viewer/vite.config.ts",
    "package": "node scripts/package.ts",
    "preview": "vite preview --config viewer/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --config viewer/vite.config.ts",
    "check": "biome check --write",
    "ci": "biome ci && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "sirv": "3.0.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "maplibre-gl": "6.16.0",
    "markdown-it": "15.0.3",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  }
}
